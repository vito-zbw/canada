---
interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#FAFAF9" />
    <meta name="generator" content={Astro.generator} />
    {description && <meta name="description" content={description} />}
    <title>{title}</title>
  </head>
  <body class="min-h-dvh bg-stone-50 text-stone-900 font-sans antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-2 focus:top-2 focus:z-50 focus:rounded focus:bg-stone-900 focus:px-4 focus:py-2 focus:text-stone-50"
    >
      Skip to content
    </a>
    <main
      id="main"
      class="mx-auto w-full max-w-7xl px-5 py-18 md:px-8 md:py-22 lg:px-16 lg:py-30"
    >
      <slot />
    </main>
    <footer
      class="mx-auto w-full max-w-7xl px-5 pb-10 text-meta text-stone-500 md:px-8 lg:px-16"
    >
      <p>© 2026 — Personal cross-Canada itinerary.</p>
    </footer>
  </body>
</html>
