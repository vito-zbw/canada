---
import type { CollectionEntry } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import TopNav from '../../../components/TopNav.astro';
import Hero from '../../../components/Hero.astro';
import MetaLine from '../../../components/MetaLine.astro';
import AnchorEventBadge from '../../../components/AnchorEventBadge.astro';
import DayList from '../../../components/DayList.astro';
import StaysList from '../../../components/StaysList.astro';
import TransportTable from '../../../components/TransportTable.astro';
import InterCityTransfer from '../../../components/InterCityTransfer.astro';
import CostTable from '../../../components/CostTable.astro';
import Map from '../../../components/Map.astro';
import PhotoGallery from '../../../components/PhotoGallery.astro';
import TransitTimeline from '../../../components/TransitTimeline.astro';
import { useTranslations, type Locale } from '../../../i18n/ui';

type Entry = CollectionEntry<'itinerary'>;
const lang: Locale = 'zh';
const t = useTranslations(lang);

// Mirror of DayItemCard.astro's kebab(). Keep these two in lockstep — the
// kebab regex is the contract between content names and manifest filenames.
function kebab(s: string): string {
  return s
    .toLowerCase()
    .normalize('NFD')
    .replace(/[̀-ͯ]/g, '')
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/(^-|-$)/g, '');
}

function buildImageKeyByPosition(enEntry: Entry): string[][] {
  return (enEntry.data.days ?? []).map((day) =>
    day.items.map((item) => kebab(item.name)),
  );
}

export const getStaticPaths = (async () => {
  const collection = await getCollection('itinerary');
  const zhEntries = collection
    .filter((e) => e.data.lang === 'zh')
    .sort((a, b) => a.data.order - b.data.order);
  // Index English entries by the bare slug so we can pair them with zh entries
  // for cross-locale image-key resolution. Plain object because the `Map`
  // identifier is shadowed by the imported `Map.astro` component.
  const enBySlug: Record<string, Entry> = {};
  for (const e of collection) {
    if (e.data.lang !== 'zh') enBySlug[e.slug] = e;
  }
  return zhEntries.map((entry, i) => {
    const bare = entry.slug.replace(/^zh\//, '');
    const enEntry = enBySlug[bare] ?? null;
    return {
      params: { slug: bare },
      props: {
        entry,
        enEntry,
        prev: i > 0 ? zhEntries[i - 1] : null,
        next: i < zhEntries.length - 1 ? zhEntries[i + 1] : null,
      },
    };
  });
}) satisfies GetStaticPaths;

interface PageProps {
  entry: Entry;
  enEntry: Entry | null;
  prev: Entry | null;
  next: Entry | null;
}

const { entry, enEntry, prev, next } = Astro.props as PageProps;
const imageKeyByPosition = enEntry
  ? buildImageKeyByPosition(enEntry)
  : undefined;
const {
  city,
  province,
  arriveDate,
  nights,
  cost,
  anchorEvent,
  order,
  updated,
  days,
  stays,
  transport,
  costBreakdown,
  gallery,
  cityMap,
} = entry.data;
const { Content } = await entry.render();

const description = t('leg.metaDescriptionTemplate', {
  order,
  city,
  province,
  nights,
  plural: '',
  date: arriveDate,
});

const slugBare = entry.slug.replace(/^zh\//, '');
const legHref = (e: Entry) =>
  `/zh/legs/${e.slug.replace(/^zh\//, '')}`;

const isTransit = entry.data.legType === 'transit';
const isStructured = Array.isArray(days) && days.length > 0;

const cityMarkers = isStructured
  ? days!
      .flatMap((d) => d.items)
      .filter((it) => typeof it.pin === 'number' && it.coords)
      .map((it) => ({
        id: `${entry.slug}-${it.pin}`,
        lat: it.coords!.lat,
        lng: it.coords!.lng,
        label: String(it.pin),
        title: it.name,
      }))
  : [];

const showLocalMap = cityMap && cityMarkers.length > 0;

const transitMarkers = isStructured
  ? days!
      .flatMap((d) => d.items)
      .filter((it) => it.kind === 'transit' && it.coords)
      .map((it, i) => ({
        id: `${entry.slug}-${i}`,
        lat: it.coords!.lat,
        lng: it.coords!.lng,
        label: it.name,
        title: it.name,
      }))
  : [];

const trainInfo =
  isTransit && Array.isArray(transport) && transport.length > 0
    ? transport[0]
    : null;

const galleryHas = Array.isArray(gallery) && gallery.length > 0;

const TRIP_CITIES = [
  'Vancouver',
  'Calgary',
  'Banff',
  'Jasper',
  'Winnipeg',
  'Ottawa',
  'Montréal',
  'Québec City',
  'Toronto',
];
function isIntercity(purpose: string): boolean {
  if (!purpose.includes('→')) return false;
  const lhs = purpose.split('→')[0]!.trim();
  return TRIP_CITIES.includes(lhs);
}
const intercityTransport = Array.isArray(transport)
  ? transport.filter((r) => isIntercity(r.purpose))
  : [];
const localTransport = Array.isArray(transport)
  ? transport.filter((r) => !isIntercity(r.purpose))
  : [];
---

<Base
  lang={lang}
  title={t('leg.metaTitle', { city })}
  description={description}
>
  <TopNav lang={lang} currentSlug={slugBare} />
  <Hero
    imageSlug={slugBare}
    title={city}
    eyebrow={t('leg.eyebrow', { order, total: 10 })}
    alt={t('leg.heroAltTemplate', { city, order })}
  />
  <section class="mt-10 md:mt-12">
    <MetaLine
      city={city}
      province={province}
      arriveDate={arriveDate}
      nights={nights}
      cost={cost}
      lang={lang}
    />
    {
      anchorEvent && (
        <div class="mt-4">
          <AnchorEventBadge
            name={anchorEvent.name}
            startDate={anchorEvent.startDate}
            endDate={anchorEvent.endDate}
            lang={lang}
          />
        </div>
      )
    }
  </section>

  {
    isTransit && isStructured ? (
      <div class="mt-10 space-y-16">
        {trainInfo && (
          <section
            class="rounded-lg border border-stone-200 bg-stone-100 p-5 md:p-6"
            aria-label={t('leg.trainInfoAria')}
          >
            <p class="text-meta font-sans uppercase tracking-[0.2em] text-stone-500">
              {trainInfo.purpose}
            </p>
            <p class="mt-1 font-serif text-h4 text-stone-900">
              {trainInfo.mode}
            </p>
            {trainInfo.note && (
              <p class="mt-2 text-meta text-stone-700">{trainInfo.note}</p>
            )}
          </section>
        )}

        <TransitTimeline days={days!} lang={lang} />

        {transitMarkers.length > 0 && (
          <Map
            variant="transit"
            markers={transitMarkers}
            routeLine
            ariaLabel={t('leg.routeMapAriaTemplate', { city: entry.data.city })}
          />
        )}

        {costBreakdown && (
          <CostTable
            breakdown={costBreakdown}
            total={cost}
            updated={updated}
            lang={lang}
          />
        )}

        {galleryHas && (
          <PhotoGallery
            slugs={gallery!.map((g) => g.slug)}
            alts={gallery!.map((g) => g.alt)}
          />
        )}

        <article
          class="max-w-prose text-body leading-relaxed text-stone-800 [&>p+p]:mt-6 [&_ul]:my-4 [&_ul]:list-disc [&_ul]:pl-6 [&_ul]:space-y-1 [&_ul]:marker:text-stone-400"
        >
          <Content />
        </article>
      </div>
    ) : isStructured ? (
      <>
        <div class="mt-10 grid grid-cols-1 gap-10 lg:grid-cols-[1fr_minmax(0,360px)]">
          {showLocalMap && (
            <aside
              class="order-first lg:order-last lg:sticky lg:top-24 lg:self-start"
              aria-label={t('leg.localMapAria')}
            >
              <Map
                variant="city"
                markers={cityMarkers}
                ariaLabel={t('leg.cityMapAriaTemplate', {
                  city: entry.data.city,
                })}
              />
            </aside>
          )}

          <div class="space-y-16">
            <DayList
              legSlug={slugBare}
              days={days!}
              lang={lang}
              imageKeyByPosition={imageKeyByPosition}
            />

            {stays && stays.length > 0 && <StaysList stays={stays} lang={lang} />}

            {intercityTransport.length > 0 && (
              <InterCityTransfer transport={intercityTransport} lang={lang} />
            )}

            {localTransport.length > 0 && (
              <TransportTable transport={localTransport} lang={lang} />
            )}

            {costBreakdown && (
              <CostTable
                breakdown={costBreakdown}
                total={cost}
                updated={updated}
                lang={lang}
              />
            )}

            {galleryHas && (
              <PhotoGallery
                slugs={gallery!.map((g) => g.slug)}
                alts={gallery!.map((g) => g.alt)}
              />
            )}

            <article
              class="max-w-prose text-body leading-relaxed text-stone-800 [&>p+p]:mt-6 [&_ul]:my-4 [&_ul]:list-disc [&_ul]:pl-6 [&_ul]:space-y-1 [&_ul]:marker:text-stone-400"
            >
              <Content />
            </article>
          </div>
        </div>
      </>
    ) : (
      <article
        class="mt-12 max-w-prose text-body leading-relaxed text-stone-800 [&>p+p]:mt-6 [&_ul]:my-4 [&_ul]:list-disc [&_ul]:pl-6 [&_ul]:space-y-1 [&_ul]:marker:text-stone-400"
      >
        <Content />
      </article>
    )
  }

  <nav
    aria-label={t('leg.tripNavAria')}
    class="mt-22 flex flex-col gap-4 border-t border-stone-200 pt-8 md:flex-row md:justify-between"
  >
    {
      prev ? (
        <a
          href={legHref(prev)}
          class="group block rounded-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-forest-700"
        >
          <span class="block text-meta uppercase tracking-[0.2em] text-stone-500">
            {t('leg.previous')}
          </span>
          <span class="mt-1 block font-serif text-h3 text-stone-900 group-hover:text-forest-700">
            ← {prev.data.city}
          </span>
        </a>
      ) : (
        <span aria-hidden="true" />
      )
    }
    {
      next ? (
        <a
          href={legHref(next)}
          class="group block rounded-sm text-right focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-forest-700 md:text-right"
        >
          <span class="block text-meta uppercase tracking-[0.2em] text-stone-500">
            {t('leg.next')}
          </span>
          <span class="mt-1 block font-serif text-h3 text-stone-900 group-hover:text-forest-700">
            {next.data.city} →
          </span>
        </a>
      ) : (
        <span aria-hidden="true" />
      )
    }
  </nav>
</Base>
