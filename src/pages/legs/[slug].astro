---
import type { CollectionEntry } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import TopNav from '../../components/TopNav.astro';
import Hero from '../../components/Hero.astro';
import MetaLine from '../../components/MetaLine.astro';
import AnchorEventBadge from '../../components/AnchorEventBadge.astro';
import DayJumpNav from '../../components/DayJumpNav.astro';
import DayList from '../../components/DayList.astro';
import StaysList from '../../components/StaysList.astro';
import TransportTable from '../../components/TransportTable.astro';
import CostTable from '../../components/CostTable.astro';
import Map from '../../components/Map.astro';
import PhotoGallery from '../../components/PhotoGallery.astro';
import TransitTimeline from '../../components/TransitTimeline.astro';

type Entry = CollectionEntry<'itinerary'>;

export const getStaticPaths = (async () => {
  const all = (await getCollection('itinerary')).sort(
    (a, b) => a.data.order - b.data.order,
  );
  return all.map((entry, i) => ({
    params: { slug: entry.slug },
    props: {
      entry,
      prev: i > 0 ? all[i - 1] : null,
      next: i < all.length - 1 ? all[i + 1] : null,
    },
  }));
}) satisfies GetStaticPaths;

interface PageProps {
  entry: Entry;
  prev: Entry | null;
  next: Entry | null;
}

const { entry, prev, next } = Astro.props as PageProps;
const {
  city,
  province,
  arriveDate,
  nights,
  cost,
  anchorEvent,
  order,
  updated,
  days,
  stays,
  transport,
  costBreakdown,
  gallery,
  cityMap,
} = entry.data;
const { Content } = await entry.render();

const description = `Leg ${order} of 10: ${city}, ${province}. ${nights} night${nights === 1 ? '' : 's'} from ${arriveDate}.`;

const isTransit = entry.data.legType === 'transit';
const isStructured = Array.isArray(days) && days.length > 0;

// Markers for the city variant: flatten days[].items[], keep only items
// with both `pin` and `coords`, project into the Map component's
// MapMarker shape (label = numbered pin, title = item name).
const cityMarkers = isStructured
  ? days!
      .flatMap((d) => d.items)
      .filter((it) => typeof it.pin === 'number' && it.coords)
      .map((it) => ({
        id: `${entry.slug}-${it.pin}`,
        lat: it.coords!.lat,
        lng: it.coords!.lng,
        label: String(it.pin),
        title: it.name,
      }))
  : [];

const showCityMap = cityMap && cityMarkers.length > 0;

// Markers for the transit variant: transit-kind items in day order
// connected by a polyline; label is the station name.
const transitMarkers = isStructured
  ? days!
      .flatMap((d) => d.items)
      .filter((it) => it.kind === 'transit' && it.coords)
      .map((it, i) => ({
        id: `${entry.slug}-${i}`,
        lat: it.coords!.lat,
        lng: it.coords!.lng,
        label: it.name,
        title: it.name,
      }))
  : [];

// Train info: derived from the leg's first transport row (the ticket).
const trainInfo =
  isTransit && Array.isArray(transport) && transport.length > 0
    ? transport[0]
    : null;

const dayJumpItems = isStructured
  ? days!.map((d, i) => ({
      id: `day-${i + 1}`,
      label: `Day ${i + 1} · ${new Intl.DateTimeFormat('en-CA', {
        month: 'short',
        day: 'numeric',
      }).format(new Date(`${d.date}T00:00:00`))}`,
    }))
  : [];

const galleryHas = Array.isArray(gallery) && gallery.length > 0;
---

<Base title={`${city} — Cross-Canada Solo Trip 2026`} description={description}>
  <TopNav currentSlug={entry.slug} />
  <Hero
    imageSlug={entry.slug}
    title={city}
    eyebrow={`Leg ${order} of 10`}
    alt={`${city}, leg ${order} of the cross-Canada trip`}
  />
  <section class="mt-10 md:mt-12">
    <MetaLine
      city={city}
      province={province}
      arriveDate={arriveDate}
      nights={nights}
      cost={cost}
    />
    {
      anchorEvent && (
        <div class="mt-4">
          <AnchorEventBadge
            name={anchorEvent.name}
            startDate={anchorEvent.startDate}
            endDate={anchorEvent.endDate}
          />
        </div>
      )
    }
  </section>

  {
    isTransit && isStructured ? (
      <div class="mt-10 space-y-16">
        {trainInfo && (
          <section
            class="rounded-lg border border-stone-200 bg-stone-100 p-5 md:p-6"
            aria-label="Train info"
          >
            <p class="text-meta font-sans uppercase tracking-[0.2em] text-stone-500">
              {trainInfo.purpose}
            </p>
            <p class="mt-1 font-serif text-h4 text-stone-900">
              {trainInfo.mode}
            </p>
            {trainInfo.note && (
              <p class="mt-2 text-meta text-stone-700">{trainInfo.note}</p>
            )}
          </section>
        )}

        <TransitTimeline days={days!} />

        {transitMarkers.length > 0 && (
          <Map
            variant="transit"
            markers={transitMarkers}
            routeLine
            ariaLabel={`Route map for ${entry.data.city}`}
          />
        )}

        {costBreakdown && (
          <CostTable
            breakdown={costBreakdown}
            total={cost}
            updated={updated}
          />
        )}

        {galleryHas && (
          <PhotoGallery
            slugs={gallery!.map((g) => g.slug)}
            alts={gallery!.map((g) => g.alt)}
          />
        )}

        <article
          class="max-w-prose text-body leading-relaxed text-stone-800 [&>p+p]:mt-6"
        >
          <Content />
        </article>
      </div>
    ) : isStructured ? (
      <>
        <div class="mt-10">
          <DayJumpNav items={dayJumpItems} />
        </div>

        <div class="mt-10 grid grid-cols-1 gap-10 lg:grid-cols-[1fr_minmax(0,360px)]">
          {showCityMap && (
            <aside
              class="order-first lg:order-last lg:sticky lg:top-24 lg:self-start"
              aria-label="Local map"
            >
              <Map
                variant="city"
                markers={cityMarkers}
                ariaLabel={`City map of ${entry.data.city} with attractions`}
              />
            </aside>
          )}

          <div class="space-y-16">
            <DayList legSlug={entry.slug} days={days!} />

            {stays && stays.length > 0 && <StaysList stays={stays} />}

            {transport && transport.length > 0 && (
              <TransportTable transport={transport} />
            )}

            {costBreakdown && (
              <CostTable
                breakdown={costBreakdown}
                total={cost}
                updated={updated}
              />
            )}

            {galleryHas && (
              <PhotoGallery
                slugs={gallery!.map((g) => g.slug)}
                alts={gallery!.map((g) => g.alt)}
              />
            )}

            <article
              class="max-w-prose text-body leading-relaxed text-stone-800 [&>p+p]:mt-6"
            >
              <Content />
            </article>
          </div>
        </div>
      </>
    ) : (
      <article
        class="mt-12 max-w-prose text-body leading-relaxed text-stone-800 [&>p+p]:mt-6"
      >
        <Content />
      </article>
    )
  }

  <nav
    aria-label="Trip navigation"
    class="mt-22 flex flex-col gap-4 border-t border-stone-200 pt-8 md:flex-row md:justify-between"
  >
    {
      prev ? (
        <a
          href={`/legs/${prev.slug}`}
          class="group block rounded-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-forest-700"
        >
          <span class="block text-meta uppercase tracking-[0.2em] text-stone-500">
            Previous leg
          </span>
          <span class="mt-1 block font-serif text-h3 text-stone-900 group-hover:text-forest-700">
            ← {prev.data.city}
          </span>
        </a>
      ) : (
        <span aria-hidden="true" />
      )
    }
    {
      next ? (
        <a
          href={`/legs/${next.slug}`}
          class="group block rounded-sm text-right focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-forest-700 md:text-right"
        >
          <span class="block text-meta uppercase tracking-[0.2em] text-stone-500">
            Next leg
          </span>
          <span class="mt-1 block font-serif text-h3 text-stone-900 group-hover:text-forest-700">
            {next.data.city} →
          </span>
        </a>
      ) : (
        <span aria-hidden="true" />
      )
    }
  </nav>
</Base>
