---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import TopNav from '../components/TopNav.astro';
import Checklist from '../components/Checklist.astro';
import ChecklistPaintGuard from '../components/ChecklistPaintGuard.astro';

const entries = (await getCollection('prep')).sort(
  (a, b) => a.data.order - b.data.order,
);

const totalItems = entries.reduce(
  (sum, e) => sum + e.data.items.length,
  0,
);

const description =
  'Pre-trip checklist: study permit, connectivity, banking, student discounts, packing. Tick items as they are done; new items added here persist on this device.';
---

<Base title="Pre-trip — Cross-Canada Solo Trip 2026" description={description}>
  <Fragment slot="head">
    <ChecklistPaintGuard />
  </Fragment>
  <TopNav currentSlug="pre-trip" />
  <header class="mt-12 max-w-prose md:mt-16">
    <p class="text-meta uppercase tracking-[0.2em] text-stone-500">
      Before the trip
    </p>
    <h1 class="mt-3 font-serif text-h1 tracking-tight md:text-display">
      Pre-trip
    </h1>
    <p class="mt-6 text-lead text-stone-700">
      {description}
    </p>
    <p class="mt-2 text-meta tabular-nums text-stone-500">
      <span aria-hidden="true">0</span><span class="sr-only">Counter hydrates after load —</span> of {totalItems} done
    </p>
  </header>

  {
    entries.length > 0 ? (
      <div class="mt-12 space-y-16">
        {entries.map((entry) => (
          <Checklist
            sectionId={entry.data.id}
            title={entry.data.title}
            items={entry.data.items}
          />
        ))}
      </div>
    ) : (
      <p class="mt-12 text-body text-stone-700">No pre-trip topics yet.</p>
    )
  }
</Base>
