---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import TopNav from '../components/TopNav.astro';
import Checklist from '../components/Checklist.astro';
import ChecklistPaintGuard from '../components/ChecklistPaintGuard.astro';
import { useTranslations, type Locale } from '../i18n/ui';

const lang: Locale = 'en';
const t = useTranslations(lang);

const entries = (await getCollection('prep'))
  .filter((e) => (e.data.lang ?? 'en') === lang)
  .sort((a, b) => a.data.order - b.data.order);

const totalItems = entries.reduce(
  (sum, e) => sum + e.data.items.length,
  0,
);

const description = t('pretrip.metaDescription');
---

<Base
  lang={lang}
  title={t('pretrip.metaTitle')}
  description={description}
>
  <Fragment slot="head">
    <ChecklistPaintGuard />
  </Fragment>
  <TopNav lang={lang} currentSlug="pre-trip" />
  <header class="mt-12 max-w-prose md:mt-16">
    <p class="text-meta uppercase tracking-[0.2em] text-stone-500">
      {t('pretrip.eyebrow')}
    </p>
    <h1 class="mt-3 font-serif text-h1 tracking-tight md:text-display">
      {t('pretrip.title')}
    </h1>
    <p class="mt-6 text-lead text-stone-700">
      {description}
    </p>
    <p class="mt-2 text-meta tabular-nums text-stone-500">
      <span aria-hidden="true">0</span><span class="sr-only"
        >{t('pretrip.counterSrLabel')}</span
      > {t('pretrip.counterTemplate', { total: totalItems })}
    </p>
  </header>

  {
    entries.length > 0 ? (
      <div class="mt-12 space-y-16">
        {entries.map((entry) => (
          <Checklist
            sectionId={entry.data.id}
            title={entry.data.title}
            items={entry.data.items}
            lang={lang}
          />
        ))}
      </div>
    ) : (
      <p class="mt-12 text-body text-stone-700">{t('pretrip.emptyState')}</p>
    )
  }
</Base>
