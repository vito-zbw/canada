---
import Base from '../layouts/Base.astro';
import TopNav from '../components/TopNav.astro';
---

<Base
  title="Off the route — Cross-Canada Solo Trip 2026"
  description="That page is not part of the trip. Try one of the ten legs."
  ogType="website"
>
  <TopNav />
  <section class="mt-22 max-w-prose md:mt-30">
    <p class="text-meta uppercase tracking-[0.2em] text-stone-500">404</p>
    <h1 class="mt-3 font-serif text-h1 tracking-tight md:text-display">
      Off the route.
    </h1>
    <p class="mt-6 text-lead text-stone-700">
      That page is not part of the trip. Try one of the ten legs — or head back
      to the start.
    </p>
    <p class="mt-10">
      <a
        href="/"
        class="text-forest-700 underline decoration-2 underline-offset-4 hover:text-forest-900 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-forest-700"
      >
        Back to the homepage →
      </a>
    </p>
  </section>
</Base>
