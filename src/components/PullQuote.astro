---
// Editorial pull-quote. Forest-700 left border, serif display size,
// generous vertical margin. Pure static markup.

export interface Props {
  quote: string;
  attribution?: string;
}

const { quote, attribution } = Astro.props;
---

<blockquote
  class="my-12 max-w-prose border-l-4 border-forest-700 pl-6 font-serif text-h3 italic text-stone-900 md:text-h2 md:pl-8"
>
  <p>{quote}</p>
  {
    attribution && (
      <cite class="mt-3 block text-meta not-italic text-stone-500">
        — {attribution}
      </cite>
    )
  }
</blockquote>
