---
// Inline <script> + <style> for <head> on /pre-trip. Runs BEFORE first
// paint to (1) remove the `no-js` class from <html> so JS-only controls
// become visible, (2) stamp the user's saved tick state onto
// <html data-prep-tick="..."> as a space-separated list of
// "sectionId:itemId" tokens, and (3) for every soft-hidden item
// (canada:prep:hide:v1), inject a <style> rule that paints the
// matching <li data-item-key="..."> as display:none from the start —
// killing the FOUC where hidden items briefly appear then disappear.
//
// Edited item text (canada:prep:edit:v1) is NOT replaced here: the
// body isn't parsed yet, so the script can't reach the <li> nodes to
// rewrite text. The Checklist island swaps text at hydration; edited
// items may flash original text for one frame. Documented trade-off.
//
// Script must be ES5 (no arrows, no const/let). is:inline keeps Astro
// from bundling it as a module — modules wait for parse, defeating
// the "before paint" goal.
---

<script is:inline>
  (function () {
    try {
      var rawTick = localStorage.getItem('canada:prep:tick:v1');
      var t = rawTick ? JSON.parse(rawTick) : {};
      var ids = [];
      for (var section in t) {
        if (Object.prototype.hasOwnProperty.call(t, section)) {
          var items = t[section];
          for (var item in items) {
            if (
              Object.prototype.hasOwnProperty.call(items, item) &&
              items[item]
            ) {
              ids.push(section + ':' + item);
            }
          }
        }
      }
      document.documentElement.setAttribute(
        'data-prep-tick',
        ids.join(' '),
      );

      var rawHide = localStorage.getItem('canada:prep:hide:v1');
      var h = rawHide ? JSON.parse(rawHide) : {};
      var selectors = [];
      for (var hsec in h) {
        if (Object.prototype.hasOwnProperty.call(h, hsec)) {
          var hItems = h[hsec];
          for (var hitem in hItems) {
            if (
              Object.prototype.hasOwnProperty.call(hItems, hitem) &&
              hItems[hitem]
            ) {
              selectors.push(
                'li.prep-item[data-item-key="' +
                  hsec +
                  ':' +
                  hitem +
                  '"]',
              );
            }
          }
        }
      }
      if (selectors.length > 0 && document.head) {
        var style = document.createElement('style');
        style.setAttribute('data-prep-hide-paint', '');
        style.textContent = selectors.join(',\n') + ' { display: none; }';
        document.head.appendChild(style);
      }
    } catch (e) {
      /* localStorage unavailable; the Checklist island will hydrate
         and apply state shortly. */
    }
    document.documentElement.classList.remove('no-js');
  })();
</script>

<style is:inline>
  /* Hook for paint-time tick styling. The Checklist island sets
     .checked after hydration; this rule is a placeholder for any
     future selector that wants to read [data-prep-tick]. */
  input[type='checkbox'][data-tick-key] {
    /* intentionally empty */
  }
</style>
