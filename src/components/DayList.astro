---
// Day-by-day scroll surface: one <section id="day-N"> per day with a
// serif heading and a vertical stack of DayItemCards. The `day-N` ids
// remain addressable for deep links (e.g. /legs/vancouver#day-3).

import type { CollectionEntry } from 'astro:content';
import DayItemCard from './DayItemCard.astro';
import { useTranslations, type Locale } from '../i18n/ui';

type Days = NonNullable<CollectionEntry<'itinerary'>['data']['days']>;

export interface Props {
  legSlug: string;
  days: Days;
  lang?: Locale;
  // Optional [dayIdx][itemIdx] → manifest-key map. /zh routes use this to
  // look up the English-keyed image cache when an item's Chinese name kebabs
  // to a different key. Position-based (not pin-based) so transit/rest items
  // without pins still resolve. Built by the page from the parallel English
  // entry, assuming zh days/items are 1:1 translations preserving order.
  imageKeyByPosition?: ReadonlyArray<ReadonlyArray<string>>;
}

const { legSlug, days, lang = 'en', imageKeyByPosition } = Astro.props;
const t = useTranslations(lang);
const intlLocale = lang === 'zh' ? 'zh-Hans-CN' : 'en-CA';

const dateFormatter = new Intl.DateTimeFormat(intlLocale, {
  weekday: 'short',
  month: 'short',
  day: 'numeric',
});

function formatDate(iso: string): string {
  return dateFormatter.format(new Date(`${iso}T00:00:00`));
}
---

{
  days.length > 0 && (
    <section aria-label={t('dayList.aria')} class="space-y-12">
      {days.map((day, dayIdx) => {
        const n = dayIdx + 1;
        const headingText = day.label
          ? t('dayList.headingWithLabel', {
              n,
              date: formatDate(day.date),
              label: day.label,
            })
          : t('dayList.heading', { n, date: formatDate(day.date) });
        return (
          <section id={`day-${n}`} class="scroll-mt-24">
            <h2 class="font-serif text-h3 tracking-tight text-stone-900">
              {headingText}
            </h2>
            <div class="mt-6 space-y-4">
              {day.items.map((item, itemIdx) => (
                <DayItemCard
                  legSlug={legSlug}
                  item={item}
                  lang={lang}
                  imageKey={imageKeyByPosition?.[dayIdx]?.[itemIdx]}
                />
              ))}
            </div>
          </section>
        );
      })}
    </section>
  )
}
