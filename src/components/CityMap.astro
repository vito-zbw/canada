---
// Per-leg SVG map with numbered pins matching DayItemCard badges.
// Equirectangular projection centered on `cityMap.centerLat/Lng` with a
// cos(lat) longitude correction so pins don't drift east-west at higher
// latitudes. Square 400x400 viewBox; the parent decides how wide to
// render it (`w-full h-auto`). Pure SVG — no JS, no tile provider.

import type { CollectionEntry } from 'astro:content';
import { cityMaps } from '../data/city-maps';

type Data = CollectionEntry<'itinerary'>['data'];

export interface CityMapPin {
  pin: number;
  name: string;
  lat: number;
  lng: number;
}

export interface Props {
  legSlug: string;
  cityMap: NonNullable<Data['cityMap']>;
  pins: CityMapPin[];
  class?: string;
}

const { legSlug, cityMap, pins, class: className = '' } = Astro.props;
const { centerLat, centerLng, radiusKm, provider } = cityMap;

if (provider === 'maplibre') {
  console.warn(
    `<CityMap> slug="${legSlug}" requested provider="maplibre" but only the SVG provider is wired in v1; falling back to SVG.`,
  );
}

const VIEW = 400;
const HALF = VIEW / 2;
const KM_PER_DEG_LAT = 111;
const KM_PER_DEG_LNG = 111 * Math.cos((centerLat * Math.PI) / 180);
const UNITS_PER_KM = HALF / radiusKm;

function project(lat: number, lng: number): { x: number; y: number } {
  const dx_km = (lng - centerLng) * KM_PER_DEG_LNG;
  const dy_km = (lat - centerLat) * KM_PER_DEG_LAT;
  return {
    x: HALF + dx_km * UNITS_PER_KM,
    y: HALF - dy_km * UNITS_PER_KM,
  };
}

// Scale-bar km value: pick the largest "nice" value that fits roughly
// 18% of the viewBox width. Keeps the bar meaningful at any zoom.
const SCALE_CANDIDATES = [0.5, 1, 2, 5, 10, 20, 50, 100, 200];
const TARGET_UNITS = VIEW * 0.18;
let barKm = SCALE_CANDIDATES[0];
for (const c of SCALE_CANDIDATES) {
  if (c * UNITS_PER_KM <= TARGET_UNITS) barKm = c;
}
const barLength = barKm * UNITS_PER_KM;
const barX = 16;
const barY = VIEW - 24;

const coastPath = cityMaps[legSlug]?.coastPath;
const landmarkPath = cityMaps[legSlug]?.landmarkPath;

const projected = pins
  .filter((p) => Number.isFinite(p.lat) && Number.isFinite(p.lng))
  .map((p) => ({ ...p, ...project(p.lat, p.lng) }));

const titleText = 'Local map';
const descText = projected.map((p) => `Pin ${p.pin}: ${p.name}.`).join(' ');

const captionText = projected
  .slice()
  .sort((a, b) => a.pin - b.pin)
  .map((p) => `${p.pin}: ${p.name}`)
  .join(', ');
---

{
  projected.length > 0 && (
    <figure class:list={['w-full', className]}>
      <svg
        viewBox={`0 0 ${VIEW} ${VIEW}`}
        role="img"
        aria-labelledby={`citymap-${legSlug}-title citymap-${legSlug}-desc`}
        class="block h-auto w-full"
      >
        <title id={`citymap-${legSlug}-title`}>{titleText}</title>
        <desc id={`citymap-${legSlug}-desc`}>{descText}</desc>

        <rect width={VIEW} height={VIEW} fill="#F5F5F4" />

        {coastPath && (
          <path d={coastPath} fill="#DBEAFE" />
        )}
        {landmarkPath && (
          <path d={landmarkPath} fill="#D6E4D6" />
        )}

        {/* Pins (clipped to viewBox by overflow:hidden on the rect) */}
        {projected.map((p) => (
          <g>
            <circle cx={p.x} cy={p.y} r={9} fill="#1F3D2B" />
            <text
              x={p.x}
              y={p.y}
              text-anchor="middle"
              dominant-baseline="central"
              font-size="11"
              font-family="ui-sans-serif, system-ui, sans-serif"
              font-weight="600"
              fill="#FFFFFF"
              class="select-none"
            >
              {p.pin}
            </text>
          </g>
        ))}

        {/* Distance scale bar */}
        <g>
          <line
            x1={barX}
            y1={barY}
            x2={barX + barLength}
            y2={barY}
            stroke="#44403C"
            stroke-width="2"
          />
          <line
            x1={barX}
            y1={barY - 4}
            x2={barX}
            y2={barY + 4}
            stroke="#44403C"
            stroke-width="2"
          />
          <line
            x1={barX + barLength}
            y1={barY - 4}
            x2={barX + barLength}
            y2={barY + 4}
            stroke="#44403C"
            stroke-width="2"
          />
          <text
            x={barX + barLength / 2}
            y={barY + 16}
            text-anchor="middle"
            font-size="10"
            font-family="ui-sans-serif, system-ui, sans-serif"
            fill="#44403C"
            class="select-none"
          >
            {barKm < 1 ? `${barKm * 1000} m` : `${barKm} km`}
          </text>
        </g>
      </svg>
      {captionText && (
        <figcaption class="mt-2 text-meta text-stone-500">
          {captionText}
        </figcaption>
      )}
    </figure>
  )
}
