---
// Vertical timeline of transit stops across a multi-day route. One <ol>
// per day, each <li> a station stop with time + name + optional note.
// A dashed rail segment marks a > 3-hour gap (overnight crossings).

import type { CollectionEntry } from 'astro:content';
import { useTranslations, type Locale } from '../i18n/ui';

type Days = NonNullable<CollectionEntry<'itinerary'>['data']['days']>;
type DayItem = Days[number]['items'][number];

export interface Props {
  days: Days;
  title?: string;
  lang?: Locale;
}

const { days, title: titleOverride, lang = 'en' } = Astro.props;
const t = useTranslations(lang);
const title = titleOverride ?? t('timetable.title');
const intlLocale = lang === 'zh' ? 'zh-Hans-CN' : 'en-CA';

// Filter to transit stops; preserve day boundaries.
const dayGroups = days
  .map((d, dayIdx) => ({
    n: dayIdx + 1,
    date: d.date,
    label: d.label,
    items: d.items.filter((it) => it.kind === 'transit'),
  }))
  .filter((g) => g.items.length > 0);

const dateFormatter = new Intl.DateTimeFormat(intlLocale, {
  weekday: 'short',
  month: 'short',
  day: 'numeric',
});

function formatDayHeading(n: number, date: string, label?: string): string {
  const d = dateFormatter.format(new Date(`${date}T00:00:00`));
  return label
    ? t('dayList.headingWithLabel', { n, date: d, label })
    : t('dayList.heading', { n, date: d });
}

const isoTimeRe = /^([0-2]\d):([0-5]\d)$/;

function parseHours(time?: string): number | null {
  if (!time) return null;
  const m = isoTimeRe.exec(time);
  if (!m) return null;
  return Number(m[1]) + Number(m[2]) / 60;
}

function isoDatetime(date: string, time?: string): string | null {
  if (!time || !isoTimeRe.test(time)) return null;
  return `${date}T${time}`;
}

// Compute "previous-to-this gap > 3h" for each item, flattened across
// days. Across-day boundaries are always treated as > 3h.
const flat: Array<{
  groupIdx: number;
  itemIdx: number;
  item: DayItem;
  gapDashed: boolean;
  isFirstOverall: boolean;
}> = [];
let prevGroupIdx = -1;
let prevHours: number | null = null;
dayGroups.forEach((g, gi) => {
  g.items.forEach((it, ii) => {
    const currHours = parseHours(it.time);
    let gapDashed = false;
    if (flat.length > 0) {
      if (gi !== prevGroupIdx) {
        gapDashed = true;
      } else if (prevHours !== null && currHours !== null) {
        gapDashed = currHours - prevHours > 3;
      }
    }
    flat.push({
      groupIdx: gi,
      itemIdx: ii,
      item: it,
      gapDashed,
      isFirstOverall: flat.length === 0,
    });
    prevGroupIdx = gi;
    if (currHours !== null) prevHours = currHours;
  });
});
---

{
  dayGroups.length > 0 && (
    <section class="space-y-6">
      <h2 class="font-serif text-h3 tracking-tight text-stone-900">{title}</h2>
      <div class="space-y-8">
        {dayGroups.map((g, gi) => (
          <div>
            <p class="text-meta font-sans uppercase tracking-[0.2em] text-stone-500">
              {formatDayHeading(g.n, g.date, g.label)}
            </p>
            <ol class="mt-3 space-y-0">
              {g.items.map((it, ii) => {
                const flatRow = flat.find(
                  (f) => f.groupIdx === gi && f.itemIdx === ii,
                )!;
                const dt = isoDatetime(g.date, it.time);
                return (
                  <li class="relative pl-8">
                    {/* rail */}
                    {!flatRow.isFirstOverall && (
                      <span
                        aria-hidden="true"
                        class:list={[
                          'absolute left-[10px] top-0 h-4 w-px',
                          flatRow.gapDashed
                            ? 'border-l-2 border-dashed border-forest-700'
                            : 'border-l-2 border-forest-700',
                        ]}
                      />
                    )}
                    <span
                      aria-hidden="true"
                      class="absolute left-[10px] top-4 h-full w-px border-l-2 border-forest-700"
                    />
                    {/* dot */}
                    <span
                      aria-hidden="true"
                      class="absolute left-1 top-3 h-4 w-4 rounded-full border-2 border-forest-700 bg-stone-50"
                    />
                    <div class="md:grid md:grid-cols-[6rem_1fr] md:gap-4 md:items-baseline">
                      <p class="text-meta tabular-nums text-stone-700">
                        {dt ? (
                          <time datetime={dt}>{it.time}</time>
                        ) : (
                          it.time ?? ''
                        )}
                      </p>
                      <div>
                        <h3 class="font-serif text-h4 leading-tight text-stone-900">
                          {it.name}
                        </h3>
                        {it.note && (
                          <p class="mt-1 text-meta text-stone-500">{it.note}</p>
                        )}
                      </div>
                    </div>
                  </li>
                );
              })}
            </ol>
          </div>
        ))}
      </div>
    </section>
  )
}
