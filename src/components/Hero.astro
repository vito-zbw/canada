---
// Full-bleed editorial hero. Image + dark-gradient overlay + title block.
//
// headingLevel: 'h1' is the default and is correct for page-level heroes
// (homepage, individual leg page). Pass 'h2' when the Hero is a section-level
// banner — keeps the page's heading hierarchy valid.

import Image from './Image.astro';

export interface Props {
  imageSlug: string;
  title: string;
  eyebrow?: string;
  subtitle?: string;
  alt: string;
  headingLevel?: 'h1' | 'h2';
}

const {
  imageSlug,
  title,
  eyebrow,
  subtitle,
  alt,
  headingLevel = 'h1',
} = Astro.props;

const HeadingTag = headingLevel;
---

<section class="relative isolate -mx-5 md:-mx-8 lg:-mx-16">
  <Image slug={imageSlug} variant="hero" alt={alt} class="w-full" />
  <div
    class="pointer-events-none absolute inset-0 bg-gradient-to-t from-stone-900/70 via-stone-900/30 to-transparent"
    aria-hidden="true"
  >
  </div>
  <div
    class="absolute inset-x-0 bottom-0 px-5 pb-8 text-stone-50 md:px-8 md:pb-12 lg:px-16 lg:pb-16"
  >
    {
      eyebrow && (
        <p class="text-meta uppercase tracking-[0.2em] text-stone-50/80">
          {eyebrow}
        </p>
      )
    }
    <HeadingTag
      class="mt-2 max-w-prose font-serif text-h1 tracking-tight md:text-display"
    >
      {title}
    </HeadingTag>
    {
      subtitle && (
        <p class="mt-3 max-w-prose text-lead text-stone-50/90">{subtitle}</p>
      )
    }
  </div>
</section>
