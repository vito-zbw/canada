---
// One row of the day-by-day list: thumbnail + numbered map pin + title +
// meta line + optional note. Layout stays horizontal at every viewport;
// DayList stacks these vertically with `gap-4`.
//
// Image resolution (issue #108):
//   1. item.image explicit override → /images/<slug>/<image>.jpg
//   2. manifest convention for kind ∈ {attraction, meal, event, transit}
//        → /images/<slug>/items/<kebab(name)>.jpg, alt from manifest
//   3. icon-block fallback — always for kind = rest, and for any
//      photographable item whose manifest entry is missing (e.g.,
//      Pexels returned nothing even for the kind-themed fallback)

import type { CollectionEntry } from 'astro:content';
import manifest from '../../public/images/manifest.json';

type DayItem = NonNullable<
  CollectionEntry<'itinerary'>['data']['days']
>[number]['items'][number];

export interface Props {
  legSlug: string;
  item: DayItem;
}

// MUST match scripts/fetch-images.ts kebab() exactly. The convention is the
// contract between the fetcher and this component — if you change one, change
// the other. See docs/CONTENT-MODEL.md for the canonical regex.
function kebab(s: string): string {
  return s
    .toLowerCase()
    .normalize('NFD')
    .replace(/[̀-ͯ]/g, '')
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/(^-|-$)/g, '');
}

interface ManifestItemEntry {
  filename: string;
  alt: string;
}
interface ManifestLeg {
  items?: Record<string, ManifestItemEntry>;
}
const typedManifest = manifest as Record<string, ManifestLeg>;

const PHOTOGRAPHABLE: ReadonlySet<DayItem['kind']> = new Set([
  'attraction',
  'meal',
  'event',
  'transit',
]);

const { legSlug, item } = Astro.props;
const { pin, name, kind, time, durationMin, cost, note, image } = item;

const titleId = `dayitem-${legSlug}-${pin ?? `${kind}-${name.replace(/\s+/g, '-').toLowerCase()}`}`;

const KIND_GLYPH: Record<DayItem['kind'], string> = {
  attraction: '\u{1F4CD}',
  meal: '\u{1F37D}',
  event: '\u{1F39F}',
  transit: '\u{1F686}',
  rest: '\u{1F6CF}',
};

function formatDuration(min: number): string {
  const h = Math.floor(min / 60);
  const m = min % 60;
  if (h > 0 && m > 0) return `${h}h ${m}m`;
  if (h > 0) return `${h}h`;
  return `${m}m`;
}

const costLabel =
  typeof cost === 'number'
    ? new Intl.NumberFormat('en-CA', {
        style: 'currency',
        currency: 'CAD',
        maximumFractionDigits: 0,
      }).format(cost)
    : null;

const metaParts = [
  time ?? null,
  typeof durationMin === 'number' ? formatDuration(durationMin) : null,
  costLabel,
].filter((part): part is string => part !== null && part !== '');

let resolvedImage: { src: string; alt: string } | null = null;
if (image) {
  resolvedImage = { src: `/images/${legSlug}/${image}.jpg`, alt: name };
} else if (PHOTOGRAPHABLE.has(kind)) {
  const key = kebab(name);
  const entry = typedManifest[legSlug]?.items?.[key];
  if (entry) {
    resolvedImage = {
      src: `/images/${legSlug}/items/${entry.filename}`,
      alt: entry.alt && entry.alt.trim() !== '' ? entry.alt : name,
    };
  }
}
---

<article
  aria-labelledby={titleId}
  class="flex items-start gap-4"
>
  <div class="relative flex-shrink-0">
    <div
      class="flex h-20 w-20 items-center justify-center overflow-hidden rounded-md bg-stone-100"
    >
      {
        resolvedImage ? (
          <img
            src={resolvedImage.src}
            alt={resolvedImage.alt}
            width={80}
            height={80}
            loading="lazy"
            decoding="async"
            class="h-full w-full object-cover"
          />
        ) : (
          <span aria-hidden="true" class="text-2xl">
            {KIND_GLYPH[kind]}
          </span>
        )
      }
    </div>
    {
      pin && (
        <span
          aria-label={`Map pin ${pin}`}
          class="absolute -left-2 -top-2 inline-flex h-6 min-w-[1.5rem] items-center justify-center rounded-full bg-forest-700 px-1 font-sans text-xs font-semibold tabular-nums text-white"
        >
          {pin}
        </span>
      )
    }
  </div>

  <div class="min-w-0 flex-1">
    <h3
      id={titleId}
      class="font-serif text-h4 leading-tight text-stone-900"
    >
      {name}
    </h3>
    {
      metaParts.length > 0 && (
        <p class="mt-1 text-meta text-stone-500">
          {metaParts.map((part, i) => (
            <>
              {i > 0 && <span aria-hidden="true"> · </span>}
              <span>{part}</span>
            </>
          ))}
        </p>
      )
    }
    {
      note && (
        <p class="mt-1 text-meta text-stone-600">
          {note}
        </p>
      )
    }
  </div>
</article>
