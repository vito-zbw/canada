---
// Cost breakdown table. Reconciles the breakdown sum against the leg's
// single-number `cost` and surfaces a visible warning when they diverge
// by more than $5 — editorial feedback, not a build failure.

import type { CollectionEntry } from 'astro:content';
import { useTranslations, type Locale } from '../i18n/ui';

type Data = CollectionEntry<'itinerary'>['data'];
type CostBreakdown = NonNullable<Data['costBreakdown']>;

export interface Props {
  breakdown: CostBreakdown;
  total?: Data['cost'];
  updated?: Data['updated'];
  title?: string;
  lang?: Locale;
}

const {
  breakdown,
  total,
  updated,
  title: titleOverride,
  lang = 'en',
} = Astro.props;
const t = useTranslations(lang);
const title = titleOverride ?? t('cost.title');
const intlLocale = lang === 'zh' ? 'zh-Hans-CN' : 'en-CA';

const ROWS: Array<{ key: keyof CostBreakdown; label: string }> = [
  { key: 'lodging', label: t('cost.lodging') },
  { key: 'food', label: t('cost.food') },
  { key: 'transportLocal', label: t('cost.transportLocal') },
  { key: 'activities', label: t('cost.activities') },
  { key: 'buffer', label: t('cost.buffer') },
];

const rendered = ROWS.filter(
  (r) => typeof breakdown[r.key] === 'number',
);

const sum = rendered.reduce((acc, r) => acc + (breakdown[r.key] ?? 0), 0);

const cad = new Intl.NumberFormat(intlLocale, {
  style: 'currency',
  currency: 'CAD',
  maximumFractionDigits: 0,
});

const dateFormatter = new Intl.DateTimeFormat(intlLocale, {
  month: 'short',
  day: 'numeric',
  year: 'numeric',
});

const captionText = updated
  ? t('cost.estimatedUpdated', {
      date: dateFormatter.format(new Date(`${updated}T00:00:00`)),
    })
  : null;

const mismatch =
  typeof total === 'number' && Math.abs(total - sum) > 5
    ? { sum, total }
    : null;
---

{
  rendered.length > 0 && (
    <section class="space-y-3">
      <h2 class="font-serif text-h3 tracking-tight text-stone-900">{title}</h2>
      <table class="w-full border-collapse text-meta">
        {captionText && (
          <caption class="pb-2 text-left text-meta text-stone-500">
            {captionText}
          </caption>
        )}
        <thead>
          <tr class="border-b border-stone-200 text-left">
            <th scope="col" class="py-2 pr-3 font-sans font-semibold text-stone-700">
              {t('cost.category')}
            </th>
            <th scope="col" class="py-2 pl-3 text-right font-sans font-semibold text-stone-700">
              {t('cost.amount')}
            </th>
          </tr>
        </thead>
        <tbody>
          {rendered.map((r) => (
            <tr class="border-b border-stone-100">
              <th scope="row" class="py-2 pr-3 text-left font-normal text-stone-900">
                {r.label}
              </th>
              <td class="py-2 pl-3 text-right tabular-nums text-stone-900">
                {cad.format(breakdown[r.key]!)}
              </td>
            </tr>
          ))}
        </tbody>
        <tfoot>
          <tr class="border-t-2 border-stone-300">
            <th scope="row" class="py-3 pr-3 text-left font-semibold text-stone-900">
              {t('cost.total')}
            </th>
            <td class="py-3 pl-3 text-right font-semibold tabular-nums text-stone-900">
              {cad.format(sum)}
            </td>
          </tr>
        </tfoot>
      </table>
      {mismatch && (
        <p class="text-meta text-red-700">
          {t('cost.mismatch', {
            sum: cad.format(mismatch.sum),
            total: cad.format(mismatch.total),
          })}
        </p>
      )}
    </section>
  )
}
