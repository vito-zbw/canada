---
// One card on the homepage grid: thumbnail, city name, MetaLine, optional
// AnchorEventBadge. The whole card is a single focusable link.

import type { CollectionEntry } from 'astro:content';
import Image from './Image.astro';
import MetaLine from './MetaLine.astro';
import AnchorEventBadge from './AnchorEventBadge.astro';
import type { Locale } from '../i18n/ui';

export interface Props {
  entry: CollectionEntry<'itinerary'>;
  lang?: Locale;
}

const { entry, lang = 'en' } = Astro.props;
const { city, province, arriveDate, nights, cost, anchorEvent, highlights } =
  entry.data;
const slugBare = entry.slug.replace(/^zh\//, '');
const headingId = `legcard-${slugBare}`;
const href = lang === 'en' ? `/legs/${slugBare}` : `/zh/legs/${slugBare}`;
// Image lookup key for the hero image — manifest entries are keyed by the
// English/canonical slug, identical for zh entries.
const imageSlug = slugBare;
---

<a
  href={href}
  class="group block rounded-md outline-none ring-offset-2 ring-offset-stone-50 focus-visible:ring-2 focus-visible:ring-forest-700"
>
  <article aria-labelledby={headingId}>
    <Image
      slug={imageSlug}
      variant="hero"
      alt=""
      class="transition-opacity duration-300 group-hover:opacity-90"
    />
    <h3
      id={headingId}
      class="mt-4 font-serif text-h3 tracking-tight text-stone-900 group-hover:text-forest-700"
    >
      {city}
    </h3>
    <div class="mt-1">
      <MetaLine
        city={city}
        province={province}
        arriveDate={arriveDate}
        nights={nights}
        cost={cost}
        lang={lang}
      />
    </div>
    {
      highlights && highlights.length > 0 && (
        <p class="mt-2 line-clamp-2 text-meta text-stone-600">
          {highlights.join(' · ')}
        </p>
      )
    }
    {
      anchorEvent && (
        <div class="mt-3">
          <AnchorEventBadge
            name={anchorEvent.name}
            startDate={anchorEvent.startDate}
            endDate={anchorEvent.endDate}
            lang={lang}
          />
        </div>
      )
    }
  </article>
</a>
