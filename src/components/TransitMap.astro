---
// Linear route map across the transit leg's stops. Equirectangular
// projection with cos(centerLat) correction so the polyline doesn't
// stretch east-west at higher latitudes. Auto-sizes the viewBox to the
// bbox of the supplied stops with a small padding margin. No JS — pure
// SVG, mirrors the philosophy of RouteMap.

export interface Stop {
  name: string;
  lat: number;
  lng: number;
}

export interface Props {
  stops: Stop[];
  title?: string;
}

const { stops, title = 'Route' } = Astro.props;

const VIEW_W = 800;
const PAD_RATIO = 0.08;

let viewH = 200;
let projected: Array<Stop & { x: number; y: number }> = [];

if (stops.length > 0) {
  const lats = stops.map((s) => s.lat);
  const lngs = stops.map((s) => s.lng);
  const minLat = Math.min(...lats);
  const maxLat = Math.max(...lats);
  const minLng = Math.min(...lngs);
  const maxLng = Math.max(...lngs);

  const latPad = Math.max((maxLat - minLat) * PAD_RATIO, 0.05);
  const lngPad = Math.max((maxLng - minLng) * PAD_RATIO, 0.1);

  const south = minLat - latPad;
  const north = maxLat + latPad;
  const west = minLng - lngPad;
  const east = maxLng + lngPad;

  const centerLat = (south + north) / 2;
  const cosLat = Math.cos((centerLat * Math.PI) / 180);

  const latKm = (north - south) * 111;
  const lngKm = (east - west) * 111 * cosLat;

  // Square map of 800 wide ⇒ height scales to data aspect ratio. Floor
  // a minimum of 140 so a near-east-west route still has vertical room.
  viewH = Math.max(140, Math.round((VIEW_W * latKm) / lngKm));

  projected = stops.map((s) => ({
    ...s,
    x: ((s.lng - west) / (east - west)) * VIEW_W,
    y: ((north - s.lat) / (north - south)) * viewH,
  }));
}

const captionText = projected.map((s) => s.name).join(' → ');
const descText = projected.map((s, i) => `Stop ${i + 1}: ${s.name}.`).join(' ');
const polyPoints = projected
  .map((s) => `${s.x.toFixed(1)},${s.y.toFixed(1)}`)
  .join(' ');
---

{
  projected.length > 0 && (
    <figure class="w-full">
      <svg
        viewBox={`0 0 ${VIEW_W} ${viewH}`}
        role="img"
        aria-labelledby="transit-map-title transit-map-desc"
        class="block h-auto w-full rounded-md border border-stone-200"
      >
        <title id="transit-map-title">{title}</title>
        <desc id="transit-map-desc">{descText}</desc>

        <rect width={VIEW_W} height={viewH} fill="#F5F5F4" />

        <polyline
          points={polyPoints}
          fill="none"
          stroke="#1F3D2B"
          stroke-width="2"
          stroke-linejoin="round"
        />

        {projected.map((s, i) => {
          const isEnd = i === 0 || i === projected.length - 1;
          return (
            <g>
              {isEnd && (
                <circle
                  cx={s.x}
                  cy={s.y}
                  r={9}
                  fill="none"
                  stroke="#13251A"
                  stroke-width="2"
                />
              )}
              <circle
                cx={s.x}
                cy={s.y}
                r={isEnd ? 5 : 4}
                fill={isEnd ? '#13251A' : '#1F3D2B'}
              />
              <text
                x={s.x}
                y={s.y - 10}
                text-anchor="middle"
                font-size="12"
                font-family="ui-sans-serif, system-ui, sans-serif"
                fill="#1C1917"
                class="select-none"
              >
                {s.name}
              </text>
            </g>
          );
        })}
      </svg>
      {captionText && (
        <figcaption class="mt-2 text-meta text-stone-500">
          {captionText}
        </figcaption>
      )}
    </figure>
  )
}
