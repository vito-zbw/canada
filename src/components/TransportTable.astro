---
// Local transport options as a semantic <table>. Three short columns
// (Purpose, Mode, Cost) read better as rows than as cards. Optional
// `note` renders as a sub-row spanning all columns beneath its parent.

import type { CollectionEntry } from 'astro:content';
import { useTranslations, type Locale } from '../i18n/ui';

type Transport = NonNullable<CollectionEntry<'itinerary'>['data']['transport']>;

export interface Props {
  transport: Transport;
  title?: string;
  lang?: Locale;
}

const { transport, title: titleOverride, lang = 'en' } = Astro.props;
const t = useTranslations(lang);
const title = titleOverride ?? t('transport.title');
const intlLocale = lang === 'zh' ? 'zh-Hans-CN' : 'en-CA';

const cad = new Intl.NumberFormat(intlLocale, {
  style: 'currency',
  currency: 'CAD',
  maximumFractionDigits: 0,
});
---

{
  transport.length > 0 && (
    <section class="space-y-4">
      <h2 class="font-serif text-h3 tracking-tight text-stone-900">{title}</h2>
      <table class="w-full border-collapse text-meta">
        <caption class="sr-only">{t('transport.caption')}</caption>
        <thead>
          <tr class="border-b border-stone-200 text-left">
            <th scope="col" class="py-2 pr-3 font-sans font-semibold text-stone-700 min-w-[6rem]">
              {t('transport.purpose')}
            </th>
            <th scope="col" class="py-2 pr-3 font-sans font-semibold text-stone-700">
              {t('transport.mode')}
            </th>
            <th scope="col" class="py-2 pl-3 text-right font-sans font-semibold text-stone-700">
              {t('transport.cost')}
            </th>
          </tr>
        </thead>
        <tbody>
          {transport.map((row) => (
            <>
              <tr class="border-b border-stone-100 align-top">
                <td class="py-3 pr-3 text-stone-900">{row.purpose}</td>
                <td class="py-3 pr-3 text-stone-700">{row.mode}</td>
                <td class="py-3 pl-3 text-right tabular-nums text-stone-900">
                  {typeof row.costCAD === 'number' ? cad.format(row.costCAD) : '—'}
                </td>
              </tr>
              {row.note && (
                <tr class="border-b border-stone-100">
                  <td colspan="3" class="pb-3 pl-0 text-meta text-stone-500">
                    {row.note}
                  </td>
                </tr>
              )}
            </>
          ))}
        </tbody>
      </table>
    </section>
  )
}
