---
// Sticky in-page nav listing day-by-day section anchors. Pure CSS sticky
// (no JS). Authors put `<section id="day-N">` markers in their MDX and pass
// the matching items here.

export interface DayJumpNavItem {
  id: string;
  label: string;
}

export interface Props {
  items: DayJumpNavItem[];
}

const { items } = Astro.props;
---

<nav
  aria-label="Jump to day"
  class="my-8 rounded-md border border-stone-200 bg-stone-100 p-4 md:sticky md:top-20 md:my-0 md:[scroll-behavior:smooth]"
  style="scroll-behavior: smooth"
>
  <p class="text-meta uppercase tracking-[0.2em] text-stone-500">By day</p>
  <ul class="mt-2 flex flex-wrap gap-x-4 gap-y-1 md:flex-col md:gap-y-2">
    {
      items.map((it) => (
        <li>
          <a
            href={`#${it.id}`}
            class="rounded-sm text-meta text-stone-700 hover:text-forest-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-forest-700"
          >
            {it.label}
          </a>
        </li>
      ))
    }
  </ul>
</nav>
